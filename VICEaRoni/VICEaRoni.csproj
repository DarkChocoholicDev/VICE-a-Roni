<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>VICEaRoni</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Settings.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.7" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.7" />
    <PackageReference Include="Dock.Model.Avalonia" Version="12.1.0.7" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonitorControl\MonitorControl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\CPUStateView.axaml.cs">
      <DependentUpon>CPUStateView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ConsoleInputView.axaml.cs">
      <DependentUpon>ConsoleInputView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ConsoleOutputView.axaml.cs">
      <DependentUpon>ConsoleOutputView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ConsoleView.axaml.cs">
      <DependentUpon>ConsoleView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\RegisterView.axaml.cs">
      <DependentUpon>RegisterView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
