<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VICEaRoni.ViewModels"
             xmlns:views="using:VICEaRoni.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="VICEaRoni.Views.ConsoleView"
             x:DataType="vm:ConsoleViewModel">
    <Grid RowDefinitions="*, auto" Background="#F0F0F0">
        <views:ConsoleOutputControl Grid.Row="0" DataContext="{Binding ConsoleOutput}" Margin="5" FontSize="14" />
        <views:ConsoleInputControl Grid.Row="1" DataContext="{Binding ConsoleInput}" Margin="5" FontSize="14" />
    </Grid>
</UserControl>
