<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VICEaRoni.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="VICEaRoni.Views.ConsoleInputControl"
             x:DataType="vm:ConsoleInputViewModel">
    <TextBox Grid.Row="2" Name="editCommand" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, Menlo, monospace"
                FontSize="14" Margin="5" KeyDown="TextBox_KeyDown" x:Name="editCommand" PlaceholderText="Enter a command"
                Text="{Binding CommandBuffer}" TextWrapping="Wrap">
    </TextBox>
</UserControl>
